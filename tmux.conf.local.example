# ~/.tmux.conf.local — personal vybemux customizations.
#
# ~/.tmux.conf sources this file at the very beginning (source-file -q).
# The installer creates it on the first `./install.sh` run and does NOT
# overwrite it on later installations, so personal customizations are preserved.
#
# Put all values here that should stay out of the distributed tmux.conf template.

# Singleton TUI commands for the start-or-switch tabs (Prefix g / Prefix F).
# Use only the command name without arguments. Defaults: lazygit / yazi.
# Alternatives, for example: gitui, tig  |  ranger, lf, nnn
set -g @git_tui   "lazygit"
set -g @file_tui  "yazi"

# Add further personal options, aliases, or bindings here.
# Note: options set by ~/.tmux.conf itself (for example @resurrect-processes)
# CANNOT be overridden here — this file is sourced BEFORE tmux.conf, and the
# last assignment wins in tmux. Only values not set by tmux.conf can be safely
# overridden here (such as @git_tui / @file_tui).
